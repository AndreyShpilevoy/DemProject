<div style="display: none">
    <div id="dialog underConstruction" title="Deus Ex Machina переехал!">
        <p>Наше комьюнити <a href="https://discord.gg/nq6BsRk">переехало в Discord</a>, а информация про моддинг Ex Machina теперь можно найти <a href="https://deuswiki.com/w/Deus_Ex_Machina_Вики">на нашем вики-сайте - Deus Wiki</a>!</p>
        <p>Форум находится в архивном состоянии, поэтому приглашаем вас <a href="https://discord.gg/nq6BsRk">на наш Discord сервер, называется так же - Deus Ex Machina</a>.</p>
        <p>...</p>
        <p>Форум имеет ограниченный функционал, рекомендуется использовать его в режиме чтения.</p>
        <p>В данный момент невозможно создавать новые темы, но можно писать в старые.</p>
        <p>Обратите внимание на:</p>
        <p>@Html.ActionLink("Каталог файлов", "ViewForum", "Conference", new { forumId = 68 }, null)</p>
    </div>
</div>


<script>
    function openSiteUnderCostructionPopUp() {
        $("#dialog").dialog({
            modal: true,
            buttons: {
                "Продолжить просмотр": function () {
                    $(this).dialog("close");
                }
            }
        });
    };
    document.addEventListener("DOMContentLoaded", function (event) {
        var cookiesService = new CookiesService();

        var visited = cookiesService.getCookie('showedSiteUnderCostructionPopUp');
        if (visited !== 'yes') {
            var optionsDictionary = new Dictionary();
            optionsDictionary.add("expires", 86400);
            cookiesService.setCookie('showedSiteUnderCostructionPopUp', 'yes', optionsDictionary);
            openSiteUnderCostructionPopUp();
        };
    });
</script>