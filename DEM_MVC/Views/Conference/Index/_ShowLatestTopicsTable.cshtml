@using DEM_MVC.Services.HtmlHelpers
@using DEM_MVC.Services
@model IList<DEM_MVC_BL.Models.TopicModels.TopicTableViewModel>

@if (Model.Count > 0)
{
    var navigationBtnClasses = "demNavigationBtn ui-button ui-state-default ui-button-text-only nonDecoration topicPagingButton";

    <div class="topicsContainer">
        <div class="topicsCategory">
            <div class="topicsCategoryName col-sm-6 col-md-7 col-lg-6 col-xs-12">
                Активные темы
            </div>
            <div class="topicsCategoryViews col-sm-1 col-md-1 hidden-xs">
                <span class="visible-xs visible-sm hidden">Просм.</span>
                <span class="hidden-xs hidden-sm">Просмотров</span>
            </div>
            <div class="topicsCategoryPosts col-sm-1 col-md-1 hidden-xs">
                <span class="visible-xs visible-sm hidden">Собщ.</span>
                <span class="hidden-xs hidden-sm">Сообщений</span>
            </div>
            <div class="topicsCategoryLastPost col-sm-3 col-md-3 col-lg-4 hidden-xs">
                Последнее сообщение
            </div>
        </div>
        <div class="topicsCategoryBody">
            @for (int i = 0; i < Model.Count; i++)
            {
                var topicRowBg = "topicColor2";
                var topicColorCode = "this.style.background='#464646';";
                if (HelpfulFunctionsService.IsOdd(i))
                {
                    topicRowBg = "topicColor1";
                    topicColorCode = "this.style.background='transparent';";
                }
                var topic = Model[i];
                <div class="topic @topicRowBg" onmouseover=@Html.Raw("this.style.background='#666';") onmouseout=@topicColorCode>
                    <div class="topicsCategoryName col-sm-6 col-md-7 col-lg-6 col-xs-12">
                        <div class="topicNameInForum">
                            @Html.ActionLink(topic.Title, "ViewTopic", "Conference", new { topicId = topic.TopicId }, null)
                            @{
                                DateTime topicStartDate = topic.TopicStartTime;
                                DateTime lastPostDate = topic.LastPostTime;
                                System.Globalization.CultureInfo culture = new System.Globalization.CultureInfo("ru-RU");
                                var dateCreatedString = topicStartDate.ToString("d MMMM yyyy", culture);
                                var dateCreatedStringShort = topicStartDate.ToShortDateString();
                                var dateLastPostString = lastPostDate.ToString("f", culture);
                            }
                            @if (topic.TopicClosed)
                            {
                                @Html.Span(" - тема закрыта", new { @class = "colorRed textBold" })
                            }
                            <div class="visible-xs hidden">
                                <span style="color: #@topic.TopicStarterGroupColor; font-weight: bold;">@Html.Raw(topic.TopicStarterUsername)</span>
                                <span style="font-weight: normal;">| Cоздана @dateCreatedStringShort</span>
                                <div class="topicsCategoryNameDescriptionPaging">
                                    @Html.PostPagingForViewForum(topic, "ViewTopic", "Conference", new { @class = navigationBtnClasses })
                                </div>
                            </div>
                            <div class="hidden-xs" style="font-weight: normal;">
                                <span>Cоздана </span>
                                <span style="color: #@topic.TopicStarterGroupColor; font-weight: bold;">@Html.Raw(topic.TopicStarterUsername)</span>
                                <span>@dateCreatedString</span>
                                <div class="topicsCategoryNameDescriptionPaging">
                                    @Html.PostPagingForViewForum(topic, "ViewTopic", "Conference", new { @class = navigationBtnClasses })
                                </div>
                            </div>
                        </div>
                        <div class="clear"></div>
                    </div>
                    <div class="topicsCategoryViews col-sm-1 col-md-1 hidden-xs">
                        @topic.TopicViews
                    </div>
                    <div class="topicsCategoryPosts col-sm-1 col-md-1 hidden-xs">
                        @topic.PostsCount
                    </div>
                    <hr class="small-hr col-xs-12 hidden visible-xs">
                    <div class="topicsCategoryLastPost col-sm-3 col-md-3 col-lg-4 col-xs-12">
                        <span class="visible-xs hidden marginRight">Последнее сообщение:</span>
                        <div class="marginRight">
                            <span style="color: #@topic.LastPostGroupColor; font-weight: bold;">@Html.Raw(topic.LastPostUsername)</span>
                        </div>
                        <div>
                            @dateLastPostString
                            <a href="@Url.Action("ViewTopic", "Conference", new { topicId = topic.TopicId, page = topic.PagesCount, postId = topic.LastPostId })">
                                <img alt=">>" title="К первому непрочитанному сообщению" src="../wwwroot/images/DEM/last_post.gif">
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <br />
}