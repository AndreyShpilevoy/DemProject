@model DEM_MVC.Models.AccountViewModels.SendCodeViewModel

@{
    ViewBag.Title = "Отправить код - DeusExMachina Форум";
}

<h2>@ViewBag.Title.</h2>

@using (Html.BeginForm("SendCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" })) {
    @Html.AntiForgeryToken()
    @Html.Hidden("rememberMe", @Model.RememberMe)
    <h4>Отправить код верификации</h4>
    <hr />
    <div class="row">
        <div class="col-md-8">
            Выберите провайдера двухфакторной аутентификации:
            @Html.DropDownListFor(model => model.SelectedProvider, Model.Providers)
            <input type="submit" value="Submit" class="ui-button ui-state-default ui-button-text-only ui-button-external-logins" />
        </div>
    </div>
}

