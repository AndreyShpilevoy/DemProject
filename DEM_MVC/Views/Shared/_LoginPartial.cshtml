@using Microsoft.AspNet.Identity
@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm" }))
    {
        @Html.AntiForgeryToken()

        <li class="main-menu-last-li"><a href="javascript:document.getElementById('logoutForm').submit()">Выйти</a></li>
        <li class="main-menu-pre-last-li">
            @Html.ActionLink("Приветствую тебя, " + User.Identity.GetUserName() + "!", "Index", "Manage", routeValues: null, htmlAttributes: new { title = "Manage" })
        </li>
    }
}
else
{
    <li class="main-menu-last-li">
        @if (Request.Url != null)
        {
            @Html.ActionLink("Войти", "Login", "Account", routeValues: new { returnUrl = Request.Url.PathAndQuery }, htmlAttributes: new { id = "loginLink" })
        }</li>
    <li class="main-menu-pre-last-li">@Html.ActionLink("Регистрация", "Register", "Account", routeValues: null, htmlAttributes: new { id = "registerLink" })</li>
}
