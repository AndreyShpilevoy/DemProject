@model DEM_MVC.Models.ManageViewModels.IndexViewModel
@{
    ViewBag.Title = "Аккаунт - DeusExMachina Форум";
}
<meta name="description" content="Управление аккаунтом на форуме DeusExMachina.">
<h2>Управление аккаунтом</h2>

<p class="text-success">@ViewBag.StatusMessage</p>
<div>
    <h4>Здесь можно поменять настройки вашего аккаунта</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Пароль:</dt>
        <dd>
            [
            @if (Model.HasPassword)
            {
                @Html.ActionLink("Изменить пароль", "ChangePassword")
            }
            else
            {
                @Html.ActionLink("Добавить пароль", "SetPassword")
            }
            ]
        </dd>
        <dt>Внешние логины:</dt>
        <dd>
            @Model.Logins.Count [
            @Html.ActionLink("Управлять", "ManageLogins") ]
        </dd>
        @* <dt>Two-Factor Authentication:</dt>
        <dd>
            <p>
                There are no two-factor authentication providers configured. See <a href="http://go.microsoft.com/fwlink/?LinkId=313242">this article</a>
                for details on setting up this ASP.NET application to support two-factor authentication.
            </p>
        </dd> *@
    </dl>
</div>
